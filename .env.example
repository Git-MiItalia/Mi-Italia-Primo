# Copy this file to .env and fill in the URLs for the environment you are
# pointing at. .env itself is gitignored because these differ per machine.
#
# Every VITE_* value is compiled into the browser bundle, so nothing secret
# belongs in here — no API keys, no tokens.

# Backend API root, including /api
VITE_API_URL=https://<host>/api

# Base URL product photos and uploaded media are served from. Paths coming
# back from the API are relative and get appended to this.
VITE_IMG_BASE_URL=https://<host>

# Public storefront, used by the "view in shop" / "view as customer" links.
#
# On a deployed environment nothing needs setting: the storefront host is
# derived from the hostname the portal is served from, swapping the leading
# "primo" for "web" (primodev -> webdev, primoqa -> webqa). So one build can
# be promoted between environments unchanged, and a deploy box or CI runner
# with no .env still produces correct links.
#
# The base below is consulted ONLY when the hostname is not a primo* host -
# localhost, an IP, a preview URL - where there is nothing to derive from.
# On a real environment the derived value wins: the host you are on is the
# truth about which environment you are in, a stale baked-in .env is not.
# Unset on localhost, the menu item shows an error toast rather than
# quietly opening the wrong site.
VITE_WEBSHOP_BASE_URL=https://<host>

# Product page route, shared by every environment. :id is substituted with
# the product id the same way a Postman path variable is ({{id}} works too).
# Defaults to /product/:id when unset.
VITE_WEBSHOP_PRODUCT_PATH=/product/:id

# Upload limits shown in the UI and enforced before a file is sent.
VITE_MAX_PHOTOS=10
VITE_MAX_VIDEOS=3
VITE_MAX_UPLOAD_COUNT=10
VITE_MAX_PHOTO_SIZE_MB=10
VITE_MAX_VIDEO_SIZE_MB=10

# Product cap fallback. The backend should send the boutique's real cap on the
# products response; this is only used when it does not.
VITE_MAX_PRODUCTS=10
